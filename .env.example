# Copy this file to .env and fill in your own values.
# Never commit a real .env file with a real API key.

# --- LLM connection (any OpenAI-compatible /v1/chat/completions endpoint) ---
# Leave LLM_API_KEY empty/unset to automatically run in offline Mock LLM mode
# (no network calls, fully deterministic — useful for local dev/tests/E2E demo).
LLM_API_KEY=

# Default points at OpenAI. Point this at any OpenAI-compatible provider instead,
# e.g. Azure OpenAI, Groq, Together AI, OpenRouter, or a local server (Ollama/vLLM).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=60

# Force mock mode even if LLM_API_KEY is set (handy for CI/tests): true/false
MOCK_LLM=false

# --- FastAPI server ---
APP_HOST=0.0.0.0
APP_PORT=8000
